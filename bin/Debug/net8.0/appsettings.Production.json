{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=${{MYSQLHOST}};Port=${{MYSQLPORT}};Database=${{MYSQLDATABASE}};User Id=${{MYSQLUSER}};Password=${{MYSQLPASSWORD}};SslMode=Required;"
  },
  "Jwt": {
    "Key": "VentifyAPI2025SecureJwtKeyProduction1234567890",
    "Issuer": "VentifyAPI",
    "Audience": "VentifyClient",
    "ExpiresInMinutes": 60
  },
  "OpenRouter": {
    "ApiKey": "",
    "BaseUrl": "https://openrouter.ai/api/v1",
    "DefaultModel": "openrouter/auto"
  }
}
