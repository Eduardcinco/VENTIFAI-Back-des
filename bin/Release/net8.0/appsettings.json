{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=${{MYSQLHOST}};Port=${{MYSQLPORT}};Database=${{MYSQLDATABASE}};User Id=${{MYSQLUSER}};Password=${{MYSQLPASSWORD}};SslMode=Required;"
  },
  "Jwt": {
    "Key": "ventify-default-secret-key-this-will-be-overridden-by-env-vars-minimum-32-chars-long!!",
    "Issuer": "VentifyAPI",
    "Audience": "VentifyClient",
    "ExpiresInMinutes": 60,
    "RefreshExpirationDays": 30
  },
  "OpenRouter": {
    "ApiKey": "default-key-will-be-overridden"
  }
}