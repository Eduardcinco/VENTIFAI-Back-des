{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=${{MYSQLHOST}};Port=${{MYSQLPORT}};Database=${{MYSQLDATABASE}};User Id=${{MYSQLUSER}};Password=${{MYSQLPASSWORD}};SslMode=Required;"
  },
  "Jwt": {
    "Secret": "ventify-default-secret-key-this-will-be-overridden-by-env-vars",
    "ExpirationInMinutes": 60
  },
  "OpenRouter": {
    "ApiKey": "default-key-will-be-overridden"
  }
}